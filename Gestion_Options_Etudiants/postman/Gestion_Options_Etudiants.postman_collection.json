              "raw": "{{baseUrl}}/options?domaine=Mathématiques",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options"
              ],
              "query": [
                {
                  "key": "domaine",
                  "value": "Mathématiques"
                }
              ]
            },
            "auth": {
              "type": "bearer",
