{
  "info": {
    "name": "SOA - Gestion Options & Etudiants (REST + JWT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ateliers REST n°1 et n°5. Lancer d'abord 'Login' : les jetons sont stockes dans les variables de la collection."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/Gestion_Options_Etudiants_war_exploded/rest"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Authentification (atelier n°5)",
      "item": [
        {
          "name": "Login (JSON) -> accessToken + refreshToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/authentication",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"I001\",\n  \"password\": \"pwd001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.accessToken);",
                  "pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (renouvelle le couple de jetons)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/authentication/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "refreshToken",
                  "value": "{{refreshToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.accessToken);",
                  "pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revoque le refresh token) -> 204",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/authentication/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "authentication",
                "logout"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "refreshToken",
                  "value": "{{refreshToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Test: GET /options SANS jeton -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "A - Ressource Option (atelier n°1)",
      "item": [
        {
          "name": "1) Creer une option -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeOption\": 6,\n  \"libelle\": \"Cybersécurité\",\n  \"domaine\": \"Informatique\",\n  \"responsable\": \"M. Responsable Cyber\",\n  \"credits\": 30,\n  \"semestre\": 2,\n  \"capacite\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2) Toutes les options -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/options",
