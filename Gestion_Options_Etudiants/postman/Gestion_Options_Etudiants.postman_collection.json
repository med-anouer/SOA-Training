              "raw": "{{baseUrl}}/options/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options",
                "6"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "5) Modifier l'option 6 -> 200 | 404",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/options/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options",
                "6"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeOption\": 6,\n  \"libelle\": \"Cyber (modifiee)\",\n  \"domaine\": \"Informatique\",\n  \"responsable\": \"M. Responsable Cyber\",\n  \"credits\": 30,\n  \"semestre\": 2,\n  \"capacite\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6) Une option par code -> 200 | 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/options/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "options",
                "1"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "B - Ressource Etudiant (atelier n°1)",
      "item": [
