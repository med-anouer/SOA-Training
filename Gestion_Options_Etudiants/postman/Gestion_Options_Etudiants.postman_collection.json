              "raw": "{\n  \"identifiant\": \"I001\",\n  \"nom\": \"Etudiant 5\",\n  \"prenom\": \"Etudiant 5\",\n  \"option\": {\n    \"codeOption\": 1,\n    \"libelle\": \"Informatique\",\n    \"domaine\": \"Informatique\",\n    \"responsable\": \"M. Responsable Informatique\",\n    \"credits\": 30,\n    \"semestre\": 1,\n    \"capacite\": 30\n  },\n  \"anneeEtude\": 2023,\n  \"email\": \"etudiant5@example.com\"\n}",
