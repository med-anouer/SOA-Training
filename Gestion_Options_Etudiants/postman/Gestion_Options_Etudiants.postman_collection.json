                "{{baseUrl}}"
              ],
              "path": [
                "options"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3) Options d'un domaine -> 200",
          "request": {
            "method": "GET",
            "header": [],
