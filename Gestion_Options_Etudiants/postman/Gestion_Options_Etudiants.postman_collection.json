              "raw": "{\n  \"identifiant\": \"I0010\",\n  \"nom\": \"Etudiant 1\",\n  \"prenom\": \"Etudiant 1\",\n  \"option\": {\n    \"codeOption\": 1,\n    \"libelle\": \"Informatique\",\n    \"domaine\": \"Informatique\",\n    \"responsable\": \"M. Responsable Informatique\",\n    \"credits\": 30,\n    \"semestre\": 1,\n    \"capacite\": 30\n  },\n  \"anneeEtude\": 2023,\n  \"email\": \"etudiant1@example.com\"\n}",
