              "host": [
                "{{graphqlUrl}}"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  getAllOptions {\n    codeOption libelle domaine responsable credits semestre capacite\n  }\n}",
                "variables": ""
