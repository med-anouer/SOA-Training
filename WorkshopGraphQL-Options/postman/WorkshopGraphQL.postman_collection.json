                "query": "query {\n  getAllOptions { codeOption libelle }\n  getEtudiantById(identifiant: \"I001\") { nom prenom }\n  getOptionsByDomaine(domaine: \"Chimie\") { libelle responsable }\n}",
                "variables": ""
              }
            }
          }
        },
