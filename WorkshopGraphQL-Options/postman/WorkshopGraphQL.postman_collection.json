              "mode": "graphql",
              "graphql": {
                "query": "query {\n  info: getOptionsByDomaine(domaine: \"Informatique\") { libelle }\n  maths: getOptionsByDomaine(domaine: \"Mathématiques\") { libelle }\n}",
